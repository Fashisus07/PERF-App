{
  "expo": {
    "name": "PERF-tmp",
    "slug": "PERF-tmp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7EF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.PERFtmp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "PERF necesita la cámara para fotografiar al animal rescatado.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PERF usa tu ubicación para registrar dónde fue el rescate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PERF necesita acceder a tus fotos para adjuntar la imagen del animal.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
