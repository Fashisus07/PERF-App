# Configuración de Supabase para PERF Móvil
# Solo van claves PÚBLICAS: todo lo que empieza con EXPO_PUBLIC_ queda dentro del APK.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_publishable_de_supabase
EXPO_PUBLIC_SUPABASE_KEY=tu_clave_publishable_de_supabase

# NUNCA poner acá la clave service_role ni la de Resend. Viven como "secrets" de las Edge Functions:
#   supabase secrets set RESEND_API_KEY=re_tu_api_key APP_URL=https://tu-app-web
